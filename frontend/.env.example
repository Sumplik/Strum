# API Base URL
# Host-nya HARUS sama dengan host tempat dashboard dibuka, karena cookie sesi memakai SameSite=Lax:
#   dashboard di http://localhost:5173  -> pakai http://localhost:3001
#   dashboard di http://127.0.0.1:5173  -> pakai http://127.0.0.1:3001
# (localhost dan 127.0.0.1 dianggap site berbeda oleh browser, cookie tidak akan terkirim.)
# Untuk tunnel/remote: https://your-tunnel-url.example.com
VITE_API_BASE_URL=http://localhost:3001

