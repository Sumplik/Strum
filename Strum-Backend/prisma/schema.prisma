generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MachineStatus {
  off
  idle
  on_duty
}

model Branch {
  id        String   @id
  name      String
  opsStart  String   @default("08:00")
  opsEnd    String   @default("17:00")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]
  logs    DeviceLog[]
}

model Device {
  id              String        @id @default(uuid())
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code            String
  status          MachineStatus @default(off)
  reportedStatus  String?
  lastSeen        DateTime      @default(now())
  location        String?
  ipAddress       String?
  firmwareVersion String?
  threshold       Float?
  arus            Float?
  voltase         Float?
  suhu            Float?
  kelembapan      Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  logs DeviceLog[]

  @@unique([branchId, code])
  @@index([branchId, status])
  @@index([branchId, lastSeen])
}

model DeviceLog {
  id             String        @id @default(uuid())
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  timestamp      DateTime
  status         MachineStatus
  reportedStatus String?
  threshold      Float?
  arus           Float?
  voltase        Float?
  suhu           Float?
  kelembapan     Float?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@unique([deviceId, timestamp])
  @@index([branchId, timestamp])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
