{
  "name": "strum-backend",
  "version": "1.0.50",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "bun run prisma/seed.ts",
    "mqtt:simulate": "bun run scripts/mqtt-simulator.ts",
    "mqtt:watch": "bun run scripts/mqtt-subscriber.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.4.2",
    "dotenv": "^17.3.1",
    "elysia": "^1.4.27",
    "fflate": "^0.8.2",
    "mqtt": "^5.15.0",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "bun-types": "^1.3.10",
    "prisma": "^7.4.2",
    "typescript": "~5.9.3"
  }
}
