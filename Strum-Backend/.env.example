# PostgreSQL connection used by Prisma (src/db.ts, prisma.config.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/iot_db?schema=public"

# Secret used to sign the auth_session JWT cookie. Required when NODE_ENV=production.
JWT_SECRET="ganti-dengan-string-acak-panjang"

# MQTT broker the telemetry subscriber connects to (username/password optional).
# Devices publish to mesin/telemetry/<ID_CABANG>, e.g. mesin/telemetry/UP2W1
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Branch that receives messages from devices still using the old topics
# (mesin/telemetry or mesin/telemetry/<ID_MESIN>). Must exist in the Branch table.
LEGACY_BRANCH_ID="UP2W6"

# HTTP port (default 3001)
PORT=3001

# Zone used for calendar days, operational hours and exported timestamps (default Asia/Jakarta)
TIMEZONE="Asia/Jakarta"

# Send the session cookie with the Secure flag (HTTPS only). Default: true when NODE_ENV=production.
# Set to false when the dashboard is served over plain http://IP:port.
COOKIE_SECURE=false

# Optional comma-separated CORS allowlist; defaults to the list in src/config.ts
# CORS_ORIGINS="http://localhost:5173,https://dashboard.example.com"

# Optional: credentials created by `bun run db:seed` (default admin / admin123)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ganti-password-ini
